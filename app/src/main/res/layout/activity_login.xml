<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FD"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ===================================================== -->
    <!-- SKY + GATE -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/imgSky"
        android:layout_width="0dp"
        android:layout_height="245dp"
        android:src="@drawable/sky_gate"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- LIGHT WHITE OVERLAY -->
    <!-- ===================================================== -->

    <View
        android:id="@+id/viewOverlay"
        android:layout_width="0dp"
        android:layout_height="190dp"
        android:background="#18FFFFFF"
        app:layout_constraintTop_toTopOf="@id/imgSky"
        app:layout_constraintStart_toStartOf="@id/imgSky"
        app:layout_constraintEnd_toEndOf="@id/imgSky" />


    <!-- ===================================================== -->
    <!-- GUJARAT VIDYAPITH LOGO -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="95dp"
        android:layout_height="70dp"
        android:layout_marginTop="5dp"
        android:src="@drawable/gvp_logo_"
        android:contentDescription="Gujarat Vidyapith Logo"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- UNIVERSITY NAME -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtUniversity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="GUJARAT VIDYAPITH"
        android:textColor="#0A2E6D"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        app:layout_constraintTop_toBottomOf="@id/imgLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- SANSKRIT -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtSanskrit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="॥ सा विद्या या विमुक्तये ॥"
        android:textColor="#D4A63F"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/txtUniversity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- AHMEDABAD -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtCity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="AHMEDABAD"
        android:textColor="#0A2E6D"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/txtSanskrit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- BLUE CURVE OVERLAY -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/imgCurve"
        android:layout_width="0dp"
        android:layout_height="125dp"
        android:src="@drawable/bg_curve"
        android:scaleType="fitXY"
        android:contentDescription="Blue Curve"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/imgSky"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- SURAKSHA SETU -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/titleLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:elevation="5dp"
        android:translationY="8dp"
        app:layout_constraintTop_toTopOf="@id/imgCurve"
        app:layout_constraintBottom_toBottomOf="@id/imgCurve"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.62">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SURAKSHA "
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SETU"
            android:textColor="#D4A63F"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- GUJARATI TAGLINE -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="સુરક્ષા અમારી, સાથ તમારો"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:elevation="5dp"
        android:translationY="8dp"
        app:layout_constraintTop_toBottomOf="@id/titleLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- ===================================================== -->
    <!-- LOGIN CARD -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/loginCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="5dp"

        android:elevation="8dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/txtTagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">


            <!-- Welcome -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Welcome Back!"
                android:textColor="#0A2E6D"
                android:textSize="27sp"
                android:textStyle="bold" />


            <!-- Login subtitle -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="2dp"
                android:text="Login to continue"
                android:textColor="#777777"
                android:textSize="13sp" />


            <!-- Username -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUsername"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusTopStart="15dp"
                app:startIconDrawable="@drawable/ic_person">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="User ID / Email"
                    android:inputType="textEmailAddress"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Password -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="15dp"
                app:boxCornerRadiusBottomStart="15dp"
                app:boxCornerRadiusTopEnd="15dp"
                app:boxCornerRadiusTopStart="15dp"
                app:startIconDrawable="@drawable/ic_password"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Forgot Password -->

            <TextView
                android:id="@+id/txtForgot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="3dp"
                android:text="Forgot Password?"
                android:textColor="#0A2E6D"
                android:textSize="12sp"
                android:textStyle="bold" />


            <!-- Login Button -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="43dp"
                android:layout_marginTop="5dp"
                android:backgroundTint="#0A2E6D"
                android:text="Login"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="15dp"
                app:icon="@drawable/ic_login"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />


            <!-- Sign Up -->

            <TextView
                android:id="@+id/txtSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="3dp"
                android:text="Don't have an account?  Sign Up"
                android:textColor="#666666"
                android:textSize="12sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ===================================================== -->
    <!-- BOTTOM FEATURES -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutFeatures"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/loginCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- Secure Campus -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_secure"
                android:contentDescription="Secure Campus" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Secure Campus"
                android:textColor="#0A2E6D"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Instant Alerts -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_alert"
                android:contentDescription="Instant Alerts" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Instant Alerts"
                android:textColor="#0A2E6D"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Help -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_help"
                android:contentDescription="Help and Support" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Help &amp; Support"
                android:textColor="#0A2E6D"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- FOOTER -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="2dp"
        android:text="© Gujarat Vidyapith - Suraksha Setu"
        android:textColor="#777777"
        android:textSize="10sp"
        app:layout_constraintTop_toBottomOf="@id/layoutFeatures"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>